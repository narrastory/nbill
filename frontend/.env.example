# 复制为 .env.development / .env.production 后按需修改。
# 注意：本文件与任何 .env 文件都不得写入真实用户名或密码。
# 测试账号只用于本地手动登录，不进入源码、环境变量或提交记录。

VITE_APP_TITLE=NBill
VITE_APP_VERSION=3.1

# 前端使用的 API 前缀。
#   - 相对路径（推荐，如 /api）：开发环境走 vite proxy，无 CORS 问题。
#   - 绝对地址（如 http://localhost:9081/api）：直连后端，需要后端放行该 Origin。
VITE_API_BASE_URL=/api

# 仅开发环境使用：dev proxy 的目标后端地址。
VITE_BACKEND_ORIGIN=http://localhost:9081
