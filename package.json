{
  "name": "nbill-monorepo",
  "version": "3.1.0",
  "private": true,
  "description": "Local-first personal accounting application",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "set-password": "npm --prefix backend run set-password",
    "test:repository": "node --test tests/repository/*.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:repository && npm run test:backend && npm run test:frontend",
    "typecheck": "npm --prefix frontend run typecheck",
    "build:frontend": "npm --prefix frontend run build",
    "publish:frontend": "node tools/publish-frontend.mjs",
    "build": "npm run build:frontend && npm run publish:frontend"
  }
}
